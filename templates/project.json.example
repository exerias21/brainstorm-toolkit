{
  "_comment": "Drop this at .claude/project.json (rename, remove _comment). All keys are optional — skills skip steps gracefully when keys are missing. See README.md for which skill reads which key.",

  "test": {
    "_comment": "Commands used by /test-check, /e2e-loop, and /sdlc. Any missing key is skipped.",
    "unit": "pytest tests/ -v --tb=short",
    "frontend": "cd web && pnpm test --run",
    "e2e": "npx playwright test --reporter=json",
    "_e2e_extras": "The next three keys tune /e2e-loop and the e2e-test-runner agent. All optional.",
    "e2e_max_fix_loops": 3,
    "e2e_patterns_file": ".claude/e2e-patterns.md",
    "e2e_rerun_failed_only": true
  },

  "logs": {
    "_comment": "Used by /test-check and the log-audit script. {service} and {tail} are substituted.",
    "command": "docker compose logs {service} --tail={tail}",
    "services": ["api", "web", "worker"]
  },

  "stack": {
    "_comment": "Optional. How to bring this project's runnable stack up/down for MANUAL verification — the hand-off at the end of /sdlc-lite, or an ad-hoc 'get it running so I can click through'. Every key optional; a missing key means that action is unavailable and skills say so instead of guessing. These are NEVER run automatically: a skill may print the command, and only runs one when you ask.",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "_rebuild_comment": "Clean rebuild — used when a dependency manifest changed (see discipline.deploy_delta_globs), where a plain restart would silently run stale code.",
    "rebuild": "docker compose up -d --build --force-recreate",
    "_url_comment": "Where to look once it is up. Printed in the hand-off so you don't have to remember the port.",
    "url": "http://localhost:3000"
  },

  "eval": {
    "_comment": "Used by /eval-harness and /sdlc stages 3-4.",
    "_runner_options": "Two patterns: (1) consumer-resident (setup.sh copied scripts/ into this repo) — use 'python3 scripts/eval-runner.py'; (2) plugin-resident (setup.sh ran with --no-copy-scripts) — use 'python3 /absolute/path/to/brainstorm-toolkit/scripts/eval-runner.py'. Plugin-resident keeps shared infra in one place and benefits from plugin updates without re-running setup.",
    "runner": "python3 scripts/eval-runner.py",
    "features_dir": "evals/",
    "_thresholds_comment": "Optional. Without this block, eval-runner uses binary pass/fail (any failure = FAIL). Generous defaults below. Stricter recommended-for-prod-bound-repos block kept alongside as a ratchet target — uncomment '_recommended_for_prod_bound_repos' values into 'thresholds' once your suite is stable. min_pass_rate is enforced in run_all_tests; max_flake_retries and min_coverage_delta are surfaced in summary for now.",
    "thresholds": {
      "min_pass_rate": 0.85,
      "max_flake_retries": 3,
      "min_coverage_delta": 0,
      "_recommended_for_prod_bound_repos": {
        "min_pass_rate": 0.98,
        "max_flake_retries": 1,
        "min_coverage_delta": 0.02
      }
    }
  },

  "gotchas_file": "GOTCHAS.md",
  "main_branch": "main",
  "modules": ["api", "web", "worker"],

  "_models_comment": "EVERY model-tier knob lives here -- canonical contract: skills/sdlc/templates/models.md. TWO INDEPENDENT AXES. Axis 1 (the fan-out ladder: cap/sanity/plan_review/implement; values haiku|sonnet|opus) all passes through capModel(). Axis 2 (code_review*; values haiku|sonnet|opus|fable) NEVER touches capModel() -- passing 'fable' to it silently no-ops with no error. 'cap' is a CEILING that only ever LOWERS, so a stage whose built-in default is haiku CANNOT be raised by cap or --model; its per-stage key here is the only lever. Per-run overrides: --model <tier> (axis 1), --review-model <name> (axis 2).",
  "models": {
    "cap": "sonnet",
    "sanity": null,
    "plan_review": null,
    "implement": null,
    "code_review": "opus",
    "code_review_second_pass": "sonnet"
  },
  "_agents_comment": "How MANY agents each fan-out stage dispatches. Cost scales roughly linearly -- one agent (or reviewer call) per entry. Unrecognized entries are ignored with one warning; the lists are deliberately open so a repo can add its own. See skills/sdlc/templates/models.md.",
  "agents": {
    "sanity_focuses": ["paths", "completeness", "gotchas"],
    "code_review_lenses": ["correctness", "plan-alignment", "config-env-docs", "security"],
    "code_review_passes": 1,
    "code_review_max_fix_loops": 3,
    "decompose_min_tasks": 6
  },

  "migrations": {
    "_comment": "Optional. Read by /repo-health Check 6 (static migration drift) and /post-deploy-verify. Omit entirely if the project has no migrations — the check self-skips.",
    "dir": "backend/migrations",
    "_applied_check_comment": "A shell command (or SQL via your DB CLI) that prints the highest applied migration version. /repo-health compares it to the highest file in 'dir' and warns if the repo is ahead (merged-but-unapplied). Without it, the check reports 'applied state unknown' rather than connecting to a DB.",
    "applied_check": "psql \"$DATABASE_URL\" -tAc \"select max(version) from schema_migrations\""
  },

  "discipline": {
    "_comment": "Optional. Tunes the self-enforcing gates. All keys have defaults; omit the block to accept them. Project-agnostic — gates self-skip when their surface is absent.",
    "staleness_hours": 24,
    "_globs_comment": "Override the changed-files-gate surface globs (see skills/sdlc/templates/changed-files-gate.md). Defaults cover the common cases; set these only for non-standard layouts.",
    "frontend_globs": ["**/*.tsx", "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.css", "**/*.scss"],
    "data_globs": ["**/migrations/**", "**/schema/**", "**/models/**", "**/*.sql"],
    "_deploy_delta_comment": "Dependency manifests/lockfiles/Dockerfiles. When the diff touches one, /sdlc flags 'rebuild required (not restart)' in the PR body + Stage-7 checklist — code committed != running env reflects it.",
    "deploy_delta_globs": ["requirements.txt", "pyproject.toml", "poetry.lock", "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "go.mod", "Cargo.toml", "Gemfile.lock", "Dockerfile", "**/Dockerfile"],
    "_memory_index_comment": "Optional path to a REPO-LOCAL memory/knowledge index for /repo-health Check 8. Leave unset to skip — the check NEVER reads the user-global ~/.claude memory dir.",
    "memory_index": null
  },

  "pipeline": {
    "_comment": "Optional. Knobs read by /sdlc. Most keys default to false/unset; decompose_min_tasks defaults to 6 when unset.",
    "skip_secret_scan": false,
    "skip_review": false,
    "_decompose_min_tasks_comment": "Optional. Stage 2 fans out into per-surface lanes only when surfaces>=2 AND task_count>=this AND the file sets are disjoint. Default 6.",
    "_skip_workflow_comment": "Claude-only off-switch for every Workflow-backed skill (/sdlc, /sdlc-lite, and /brainstorm-deep Pass 3). When true, they use their prose path instead of the deterministic Workflow even when ultracode is on. The Workflow is also only used when ultracode is explicitly enabled; this flag forces prose regardless. Copilot/Codex always use the prose path (no Workflow tool).",
    "skip_workflow": false,
    "_poka_yoke_comment": "Claude-only. When true, /repo-onboarding writes a PreToolUse hook to .claude/settings.json that blocks Write/Edit when a likely secret is in the payload. Enabling this key alone does NOT install the hook — see AGENTS.md 'Hooks (Claude-only)' for the settings.json schema. Copilot consumers gain nothing from this key (no PreToolUse equivalent); rely on the Stage 6 gitleaks scan instead.",
    "poka_yoke": false,

    "review_fix": {
      "_comment": "Optional, OFF by default. Adversarial Review->Fix stage (Stage 5.7 review / Stage 5.8 fix loop) for /sdlc and /sdlc-lite -- runs after Stage 5.6 flowsim, before Stage 6. DIFFERENT feature from 'skip_review' above: skip_review silences the single-pass built-in /review diff check at Stage 6 (post-PR, same model); review_fix is a separate pre-PR N-lens adversarial review + fix loop, default reviewer model 'opus' (see skills/sdlc/templates/models.md; the reviewer model itself now lives at models.code_review). Both toggle independently. Omit this whole block to accept the defaults below (stage stays OFF). OPT-IN, PERMANENTLY: there is no default-on flip, planned or shipped. An explicit --review-model <name> flag or an explicit enabled:true here is required to activate the stage; omitted, absent, or enabled:false all mean OFF.",
      "enabled": false,
      "mode": "interactive",
      "_mode_comment": "One of 'interactive' (default: each confirmed finding's fix spec is presented for approve/edit/skip -- degrades to auto-fix-then-pause under the Claude Workflow tool, which has no mid-run prompt primitive), 'auto' (auto-approve after auto_approve_after consecutive approvals OR confidence >= confidence_threshold -- design-decision findings, auto_fixable:false, are NEVER auto-approved regardless of mode), 'off' (report only, Stage 5.8 does not run).",
      "auto_approve_after": 2,
      "confidence_threshold": 0.85,
      "_confidence_threshold_comment": "auto mode only. A confirmed finding's adversarial-verify confidence >= this value lets it bypass the auto_approve_after counter.",
      "blocking": true,
      "_blocking_comment": "Whether a surviving HIGH-severity confirmed finding blocks Stage 6. Defaults true (matches /sdlc's PR-gate posture); /sdlc-lite treats this as false-equivalent regardless of the value here (warn-and-handoff is its posture by design, consistent with its warn-only secret scan).",
      "max_diff_lines": 1500,
      "max_files": 25,
      "_cost_bound_comment": "Above either ceiling, the diff is partitioned across decompose lanes (or changed-files-gate surfaces) so no single reviewer call carries the whole diff."
    },

    "loop": {
      "_comment": "Optional. Knobs for the --queue backlog loop (/sdlc-lite --queue), the L9 auto-continue Stop hook, and the batch-handoff runner (scripts/loop-runner.sh). All optional.",
      "max_items": 5,
      "_max_items_comment": "Max items one /sdlc-lite --queue invocation consumes before it stops (the [N] arg overrides). Default 5.",
      "batch_size": 5,
      "_batch_size_comment": "scripts/loop-runner.sh ONLY: items per FRESH headless process before context is reset (a clean completed-item boundary, never mid-plan). 5-10 is the useful range -- large enough to amortize the per-process baseline, small enough to cap growth. Resolves: --queue X flag > batch_size > max_items > 5. See docs/LOOP-HYGIENE.md.",
      "max_hops": 5,
      "_max_hops_comment": "Auto-continue (L9) hop budget: max self-continue chain length before the Stop hook parks. Default 5.",
      "auto_continue": false,
      "_auto_continue_comment": "Claude/Codex only, OFF by default. When true, the Stop hook EXECUTES a single non-confirm .next-action sentinel (decision:block) instead of only printing it, so the loop self-advances. Never chains a confirm:true action; bounded by max_hops."
    }
  }
}
