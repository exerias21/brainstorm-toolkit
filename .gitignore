# Environment files
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Consumer-side artifacts (this is a plugin repo, not a consumer)
plans/
!docs/plans/
TASKS.md
GOTCHAS.md
CHEATSHEET.md
.claude/project.json
.claude/pipeline/
.claude/.next-action
.claude/scheduled_tasks.lock

# evals/skills/fixtures/mini-fastapi/ is a COMMITTED mock consumer repo (the
# skill-eval.py harness copies it into a temp dir per run) -- its TASKS.md and
# plans/ are fixture content, not this repo's own consumer-side artifacts, so
# they need the same un-ignore treatment as docs/plans/ above.
!evals/skills/fixtures/**/plans/
!evals/skills/fixtures/**/plans/**
!evals/skills/fixtures/**/TASKS.md

# scripts/ci/skill-eval.py results — regenerated per run, not source. The
# baseline stays tracked (it's the committed cost-regression reference); order
# matters, the negation must follow the ignore or it would swallow the file.
evals/skills/results/
!evals/skills/baseline.json

# Installed plugin artifacts — produced by setup.sh when this repo is its own
# install target for dogfooding. The canonical source lives in skills/,
# copilot/skills/, codex/skills/, agents/. These trees are install output.
.claude/skills/
.claude/agents/
.claude/settings.json
.claude/project.json.example
.github/skills/
.github/hooks/
.agents/skills/

# Local test output
/tmp/
test-output/
